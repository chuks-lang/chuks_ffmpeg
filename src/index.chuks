// @chuks/ffmpeg — FFmpeg (libav) for Chuks.
//
// A self-contained Rust cdylib shim over the `ffmpeg-next` crate, with FFmpeg
// compiled from source and statically linked (no system FFmpeg dependency).
// Foundation for real-time media in Chuks: decode / encode / transcode / filter /
// resample, the audio tap that feeds @chuks/whisper, and the frame plumbing for
// @chuks/onnx effects. See docs/realtime-media-roadmap.md in the Chuks repo.
//
// ZERO-COPY (load-bearing design rule): decoded audio/video buffers are large, so
// they are exposed as BORROWED pointers (CPtr) into the shim's own memory, which
// downstream packages read directly — @chuks/whisper reads the 16 kHz mono PCM,
// @chuks/onnx borrows frame planes via tensor_from_f32_borrow. Buffers never
// round-trip through Chuks.
//
// Usage:
//   import { Ffmpeg } from "pkg/@chuks/ffmpeg"
//   const ff = new Ffmpeg()
//   println(ff.version())                                  // "b3ef323" / "8.1"
//   const pcm = ff.decodeAudio("clip.mp4")                 // 16 kHz mono f32
//   println("samples: " + string(pcm.samples()))
//   const buf = pcm.data()                                 // borrowed CPtr → whisper
//   pcm.close()

import { c, LibHandle, CFunc, CPtr, CSig } from "std/chuksToC"
import { r } from "std/chuksToRust"

// Output PCM float formats for the audio tap.
export const FFMPEG_F32: int = 0   // 32-bit float (whisper's format)
export const FFMPEG_F64: int = 1   // 64-bit float

// Video encoders for transcode(). H264/HEVC use the macOS hardware VideoToolbox
// encoders; MPEG4/MJPEG are native LGPL software encoders (cross-platform). Using
// an enum guides the caller to a valid choice instead of an arbitrary string.
export enum VideoEncoder {
    H264,    // h264_videotoolbox (macOS hardware)
    HEVC,    // hevc_videotoolbox (macOS hardware)
    MPEG4,   // native MPEG-4 Part 2
    MJPEG    // native Motion JPEG
}

// How transcode() handles the audio track. COPY keeps the original audio bytes
// as-is (fast, lossless); AAC re-encodes to AAC (needed when changing the audio
// codec, e.g. for a container that can't hold the source codec).
export enum AudioEncoder {
    COPY,    // stream-copy the audio track unchanged
    AAC      // re-encode audio to AAC (native LGPL encoder)
}

// Fluent encoder/muxer options for transcode() and createVideo(). Build one by
// chaining the setters, then pass it as the last argument:
//   const opts = new EncodeOptions().videoBitrate(12_000_000).gop(60).faststart()
//   ff.transcode("in.mp4", "out.mp4", VideoEncoder.H264, "", AudioEncoder.COPY, opts)
// Every option is optional; unset ones use the codec/muxer defaults. Options
// that don't apply to the chosen encoder are ignored (e.g. crf/preset on a
// hardware encoder), so it is safe to set them unconditionally.
export class EncodeOptions {
    var _spec: string
    constructor() { this._spec = "" }

    private add(k: string, v: string): EncodeOptions {
        this._spec = this._spec == "" ? (k + "=" + v) : (this._spec + ";" + k + "=" + v)
        return this
    }

    // Target video bit rate in bits/sec (e.g. 12000000 = 12 Mbps). The main knob
    // for hardware encoders (VideoToolbox/NVENC), which are bitrate-targeted.
    public videoBitrate(bitsPerSec: int): EncodeOptions { return this.add("vbitrate", string(bitsPerSec)) }
    // Keyframe interval in frames (GOP size). Small values (e.g. 60) make seeking
    // and parallel range-encoding land on keyframes quickly.
    public gop(frames: int): EncodeOptions { return this.add("gop", string(frames)) }
    // Constant Rate Factor for software encoders (libx264 ~18-28, libvpx ~30);
    // lower is higher quality. Ignored by hardware encoders.
    public crf(value: int): EncodeOptions { return this.add("crf", string(value)) }
    // Software encoder preset trading speed for compression, e.g. "veryfast",
    // "medium", "slow" (libx264). Ignored by hardware encoders.
    public preset(name: string): EncodeOptions { return this.add("preset", name) }
    // Drop the audio track from the output entirely (ffmpeg -an).
    public noAudio(): EncodeOptions { return this.add("an", "1") }
    // Audio bit rate in bits/sec (e.g. 192000). Applies when re-encoding audio.
    public audioBitrate(bitsPerSec: int): EncodeOptions { return this.add("abitrate", string(bitsPerSec)) }
    // Force the output container/muxer by name (e.g. "mp4") when the output path
    // has no extension for ffmpeg to infer one from.
    public format(muxer: string): EncodeOptions { return this.add("format", muxer) }
    // mp4/mov only: move the moov atom to the front (movflags +faststart) so the
    // file starts playing immediately in a browser <video> tag.
    public faststart(): EncodeOptions { return this.add("faststart", "1") }
    // Finish at the shortest input stream when muxing (ffmpeg -shortest).
    public shortest(): EncodeOptions { return this.add("shortest", "1") }
    // Override the output frame rate (drops/duplicates frames to hit it). Also
    // drives the encoder timebase, so pair it with a matching filter if resampling.
    public fps(rate: int): EncodeOptions { return this.add("fps", string(rate)) }

    // The compact spec string handed to the shim. Rarely called directly.
    public spec(): string { return this._spec }
}

// A decoded, resampled 16 kHz mono PCM buffer owned by the shim. Call close()
// when done. Its samples are readable zero-copy via data().
export class AudioBuffer {
    var _ff: Ffmpeg
    var _ptr: CPtr
    var _closed: bool
    constructor(ff: Ffmpeg, handle: CPtr) {
        this._ff = ff
        this._ptr = handle
        this._closed = false
    }

    // Number of 16 kHz mono samples.
    public samples(): int { return this._ff._audio_samples.call([this._ptr]) }

    // Output float-format code: FFMPEG_F32 (0) or FFMPEG_F64 (1).
    public format(): int { return this._ff._audio_format.call([this._ptr]) }

    // Borrowed pointer to the packed PCM buffer (valid until close()). Zero-copy:
    // pass it straight to @chuks/whisper — the samples are never copied through
    // Chuks. The CPtr is length-tagged in bytes and marked non-owning.
    public data(): CPtr {
        const raw: any = this._ff._audio_ptr.call([this._ptr])
        const n: int = this.samples()
        const elem: int = this.format() == FFMPEG_F64 ? 8 : 4
        return new CPtr(raw, false, n * elem)
    }

    public close(): void {
        if (this._closed) { return }
        this._closed = true
        this._ff._audio_free.call([this._ptr])
    }
}

// A frame-by-frame video decoder. Each next() advances to the next frame, scaled
// to packed RGB24; frame() borrows that buffer zero-copy (valid until the next
// next() / close()). Call close() when done.
export class VideoReader {
    var _ff: Ffmpeg
    var _ptr: CPtr
    var _closed: bool
    constructor(ff: Ffmpeg, handle: CPtr) {
        this._ff = ff
        this._ptr = handle
        this._closed = false
    }

    // Decode + scale the next frame to RGB24. Returns false at end of stream.
    public next(): bool {
        const rc: int = this._ff._video_next.call([this._ptr])
        if (rc < 0) { throw new Error("ffmpeg.video: " + this._ff.lastError()) }
        return rc == 1
    }

    public width(): int { return this._ff._video_width.call([this._ptr]) }
    public height(): int { return this._ff._video_height.call([this._ptr]) }
    // Bytes per row of the RGB buffer (>= width*3 due to alignment).
    public stride(): int { return this._ff._video_stride.call([this._ptr]) }

    // Borrowed pointer to the current RGB24 frame (valid until next()/close()).
    // Zero-copy: hand to @chuks/onnx to build a tensor. Byte length = stride*height.
    public frame(): CPtr {
        const raw: any = this._ff._video_ptr.call([this._ptr])
        return new CPtr(raw, false, this.stride() * this.height())
    }

    // Seek to the keyframe at or before `seconds`, then resume with next().
    // Flushes the decoder and resets stream state. Throws on error.
    public seek(seconds: float): void {
        const rc: int = this._ff._video_seek.call([this._ptr, seconds])
        if (rc < 0) { throw new Error("ffmpeg.seek: " + this._ff.lastError()) }
    }

    // Presentation time of the current frame in seconds (-1 if none/unknown).
    public pts(): float { return this._ff._video_pts.call([this._ptr]) }

    // Total duration of the media in seconds (-1 if unknown).
    public duration(): float { return this._ff._video_duration.call([this._ptr]) }

    // Save the CURRENT frame (after next()) to an image file: PNG if `path` ends
    // in ".png", else JPEG. Convenience over Ffmpeg.saveImage — e.g. grab a
    // thumbnail after seek()+next(). Throws on error.
    public saveFrame(path: string): void {
        this._ff.saveImage(this.frame(), this.width(), this.height(), path, this.stride())
    }

    public close(): void {
        if (this._closed) { return }
        this._closed = true
        this._ff._video_free.call([this._ptr])
    }
}

// A frame encoder: push rendered RGB24 frames, get an encoded video file. The
// inverse of VideoReader, for editors that render their own frames (no shelling
// out to an ffmpeg binary). Open with Ffmpeg.createVideo(), push frames with
// writeFrame(), then close() to flush + finalize. Zero-copy: writeFrame borrows
// the caller's RGB24 buffer (e.g. a VideoReader.frame()) for the call only.
export class VideoWriter {
    var _ff: Ffmpeg
    var _ptr: CPtr
    var _width: int
    var _height: int
    var _closed: bool
    constructor(ff: Ffmpeg, handle: CPtr, width: int, height: int) {
        this._ff = ff
        this._ptr = handle
        this._width = width
        this._height = height
        this._closed = false
    }

    public width(): int { return this._width }
    public height(): int { return this._height }

    // Encode one RGB24 frame. `rgb` points at width*height*3 bytes (or more with
    // padding); `stride` is its bytes per row (0 = packed width*3). To pass a
    // VideoReader frame straight through, use reader.frame() with reader.stride().
    public writeFrame(rgb: CPtr, stride: int = 0): void {
        // Use the CPtr's tagged size when known; otherwise compute it from the
        // stride/width and height (C-received pointers report size -1).
        var blen: int = rgb.size()
        if (blen < 0) {
            const s: int = stride > 0 ? stride : this._width * 3
            blen = s * this._height
        }
        const rc: int = this._ff._venc_write.call([this._ptr, rgb, blen, stride])
        if (rc < 0) { throw new Error("ffmpeg.writeFrame: " + this._ff.lastError()) }
    }

    // Flush, finalize the container, and close. Returns frames written. After
    // close() the writer is invalid. Safe to call twice (second call is a no-op).
    public close(): int {
        if (this._closed) { return 0 }
        this._closed = true
        const n: int = this._ff._venc_close.call([this._ptr])
        if (n < 0) { throw new Error("ffmpeg.videoWriter.close: " + this._ff.lastError()) }
        return n
    }
}

// Metadata about a media file, read WITHOUT decoding any frames (fast). Get one
// from Ffmpeg.probe(); call close() when done (or bind it with `using const` so
// the compiler closes it for you). All accessors are typed, so VM and AOT report
// identical values.
export class MediaInfo {
    var _ff: Ffmpeg
    var _ptr: CPtr
    var _closed: bool
    constructor(ff: Ffmpeg, handle: CPtr) {
        this._ff = ff
        this._ptr = handle
        this._closed = false
    }

    public hasVideo(): bool { return this._ff._probe_has_video.call([this._ptr]) == 1 }
    public hasAudio(): bool { return this._ff._probe_has_audio.call([this._ptr]) == 1 }
    // Video frame size in pixels (0 if no video stream).
    public width(): int { return this._ff._probe_width.call([this._ptr]) }
    public height(): int { return this._ff._probe_height.call([this._ptr]) }
    // Container duration in seconds (-1 if unknown).
    public duration(): float { return this._ff._probe_duration.call([this._ptr]) }
    // Average video frame rate in fps (0 if no video / unknown).
    public fps(): float { return this._ff._probe_fps.call([this._ptr]) }
    // Number of video frames if the container records it (0 if unknown).
    public frameCount(): int { return this._ff._probe_nb_frames.call([this._ptr]) }
    // Overall container bitrate in bits/sec (0 if unknown).
    public bitRate(): int { return this._ff._probe_bit_rate.call([this._ptr]) }
    // Audio sample rate in Hz and channel count (0 if no audio stream).
    public sampleRate(): int { return this._ff._probe_sample_rate.call([this._ptr]) }
    public channels(): int { return this._ff._probe_channels.call([this._ptr]) }
    // Codec short names, e.g. "h264" / "aac" (empty if that stream is absent).
    public videoCodec(): string { return this._ff._readAndFreeStr(this._ff._probe_video_codec.call([this._ptr])) }
    public audioCodec(): string { return this._ff._readAndFreeStr(this._ff._probe_audio_codec.call([this._ptr])) }

    public close(): void {
        if (this._closed) { return }
        this._closed = true
        this._ff._probe_free.call([this._ptr])
    }
}

export class Ffmpeg {
    var _lib: LibHandle
    var _version: CFunc
    var _free_string: CFunc
    var _last_error: CFunc
    var _audio_decode: CFunc
    var _audio_samples: CFunc
    var _audio_ptr: CFunc
    var _audio_format: CFunc
    var _audio_free: CFunc
    var _video_open: CFunc
    var _video_next: CFunc
    var _video_width: CFunc
    var _video_height: CFunc
    var _video_stride: CFunc
    var _video_ptr: CFunc
    var _video_seek: CFunc
    var _video_pts: CFunc
    var _video_duration: CFunc
    var _video_free: CFunc
    var _transcode: CFunc
    var _last_video_encoder: CFunc
    var _has_encoder: CFunc
    var _venc_open: CFunc
    var _venc_write: CFunc
    var _venc_close: CFunc
    var _mux: CFunc
    var _probe: CFunc
    var _probe_width: CFunc
    var _probe_height: CFunc
    var _probe_duration: CFunc
    var _probe_fps: CFunc
    var _probe_has_video: CFunc
    var _probe_has_audio: CFunc
    var _probe_video_codec: CFunc
    var _probe_audio_codec: CFunc
    var _probe_sample_rate: CFunc
    var _probe_channels: CFunc
    var _probe_bit_rate: CFunc
    var _probe_nb_frames: CFunc
    var _probe_free: CFunc
    var _concat_new: CFunc
    var _concat_add: CFunc
    var _concat_run: CFunc
    var _concat_free: CFunc
    var _save_image: CFunc
    var _encode_images: CFunc
    var _to_gif: CFunc

    constructor(shimManifestDir: string = "chuks_packages/@chuks/ffmpeg") {
        const libPath: string = r.cargoBuild(shimManifestDir, true)
        this._lib = c.load(libPath)
        const L: LibHandle = this._lib

        this._version = L.symbol("chuks_ffmpeg_version", new CSig([], CSig.T_PTR))
        this._free_string = L.symbol("chuks_ffmpeg_free_string", new CSig([CSig.T_PTR], CSig.T_VOID))
        this._last_error = L.symbol("chuks_ffmpeg_last_error", new CSig([], CSig.T_PTR))
        this._audio_decode = L.symbol("chuks_ffmpeg_audio_decode", new CSig([CSig.T_CSTRING, CSig.T_INT], CSig.T_PTR))
        this._audio_samples = L.symbol("chuks_ffmpeg_audio_samples", new CSig([CSig.T_PTR], CSig.T_INT64))
        this._audio_ptr = L.symbol("chuks_ffmpeg_audio_ptr", new CSig([CSig.T_PTR], CSig.T_PTR))
        this._audio_format = L.symbol("chuks_ffmpeg_audio_format", new CSig([CSig.T_PTR], CSig.T_INT))
        this._audio_free = L.symbol("chuks_ffmpeg_audio_free", new CSig([CSig.T_PTR], CSig.T_VOID))
        this._video_open = L.symbol("chuks_ffmpeg_video_open", new CSig([CSig.T_CSTRING, CSig.T_CSTRING], CSig.T_PTR))
        this._video_next = L.symbol("chuks_ffmpeg_video_next", new CSig([CSig.T_PTR], CSig.T_INT))
        this._video_width = L.symbol("chuks_ffmpeg_video_width", new CSig([CSig.T_PTR], CSig.T_INT))
        this._video_height = L.symbol("chuks_ffmpeg_video_height", new CSig([CSig.T_PTR], CSig.T_INT))
        this._video_stride = L.symbol("chuks_ffmpeg_video_stride", new CSig([CSig.T_PTR], CSig.T_INT))
        this._video_ptr = L.symbol("chuks_ffmpeg_video_ptr", new CSig([CSig.T_PTR], CSig.T_PTR))
        this._video_seek = L.symbol("chuks_ffmpeg_video_seek", new CSig([CSig.T_PTR, CSig.T_DOUBLE], CSig.T_INT))
        this._video_pts = L.symbol("chuks_ffmpeg_video_pts", new CSig([CSig.T_PTR], CSig.T_DOUBLE))
        this._video_duration = L.symbol("chuks_ffmpeg_video_duration", new CSig([CSig.T_PTR], CSig.T_DOUBLE))
        this._video_free = L.symbol("chuks_ffmpeg_video_free", new CSig([CSig.T_PTR], CSig.T_VOID))
        this._transcode = L.symbol("chuks_ffmpeg_transcode", new CSig([CSig.T_CSTRING, CSig.T_CSTRING, CSig.T_CSTRING, CSig.T_CSTRING, CSig.T_CSTRING, CSig.T_CSTRING], CSig.T_INT64))
        this._last_video_encoder = L.symbol("chuks_ffmpeg_last_video_encoder", new CSig([], CSig.T_PTR))
        this._has_encoder = L.symbol("chuks_ffmpeg_has_encoder", new CSig([CSig.T_CSTRING], CSig.T_INT))
        this._venc_open = L.symbol("chuks_ffmpeg_venc_open", new CSig([CSig.T_CSTRING, CSig.T_INT, CSig.T_INT, CSig.T_INT, CSig.T_INT, CSig.T_CSTRING, CSig.T_CSTRING], CSig.T_PTR))
        this._venc_write = L.symbol("chuks_ffmpeg_venc_write", new CSig([CSig.T_PTR, CSig.T_PTR, CSig.T_INT, CSig.T_INT], CSig.T_INT))
        this._venc_close = L.symbol("chuks_ffmpeg_venc_close", new CSig([CSig.T_PTR], CSig.T_INT64))
        this._mux = L.symbol("chuks_ffmpeg_mux", new CSig([CSig.T_CSTRING, CSig.T_CSTRING, CSig.T_CSTRING], CSig.T_INT64))
        this._probe = L.symbol("chuks_ffmpeg_probe", new CSig([CSig.T_CSTRING], CSig.T_PTR))
        this._probe_width = L.symbol("chuks_ffmpeg_probe_width", new CSig([CSig.T_PTR], CSig.T_INT))
        this._probe_height = L.symbol("chuks_ffmpeg_probe_height", new CSig([CSig.T_PTR], CSig.T_INT))
        this._probe_duration = L.symbol("chuks_ffmpeg_probe_duration", new CSig([CSig.T_PTR], CSig.T_DOUBLE))
        this._probe_fps = L.symbol("chuks_ffmpeg_probe_fps", new CSig([CSig.T_PTR], CSig.T_DOUBLE))
        this._probe_has_video = L.symbol("chuks_ffmpeg_probe_has_video", new CSig([CSig.T_PTR], CSig.T_INT))
        this._probe_has_audio = L.symbol("chuks_ffmpeg_probe_has_audio", new CSig([CSig.T_PTR], CSig.T_INT))
        this._probe_video_codec = L.symbol("chuks_ffmpeg_probe_video_codec", new CSig([CSig.T_PTR], CSig.T_PTR))
        this._probe_audio_codec = L.symbol("chuks_ffmpeg_probe_audio_codec", new CSig([CSig.T_PTR], CSig.T_PTR))
        this._probe_sample_rate = L.symbol("chuks_ffmpeg_probe_sample_rate", new CSig([CSig.T_PTR], CSig.T_INT))
        this._probe_channels = L.symbol("chuks_ffmpeg_probe_channels", new CSig([CSig.T_PTR], CSig.T_INT))
        this._probe_bit_rate = L.symbol("chuks_ffmpeg_probe_bit_rate", new CSig([CSig.T_PTR], CSig.T_INT64))
        this._probe_nb_frames = L.symbol("chuks_ffmpeg_probe_nb_frames", new CSig([CSig.T_PTR], CSig.T_INT64))
        this._probe_free = L.symbol("chuks_ffmpeg_probe_free", new CSig([CSig.T_PTR], CSig.T_VOID))
        this._concat_new = L.symbol("chuks_ffmpeg_concat_new", new CSig([], CSig.T_PTR))
        this._concat_add = L.symbol("chuks_ffmpeg_concat_add", new CSig([CSig.T_PTR, CSig.T_CSTRING], CSig.T_INT))
        this._concat_run = L.symbol("chuks_ffmpeg_concat_run", new CSig([CSig.T_PTR, CSig.T_CSTRING], CSig.T_INT64))
        this._concat_free = L.symbol("chuks_ffmpeg_concat_free", new CSig([CSig.T_PTR], CSig.T_VOID))
        this._save_image = L.symbol("chuks_ffmpeg_save_image", new CSig([CSig.T_PTR, CSig.T_INT, CSig.T_INT, CSig.T_INT, CSig.T_CSTRING], CSig.T_INT))
        this._encode_images = L.symbol("chuks_ffmpeg_encode_images", new CSig([CSig.T_CSTRING, CSig.T_CSTRING, CSig.T_CSTRING, CSig.T_CSTRING, CSig.T_CSTRING, CSig.T_INT], CSig.T_INT64))
        this._to_gif = L.symbol("chuks_ffmpeg_to_gif", new CSig([CSig.T_CSTRING, CSig.T_CSTRING, CSig.T_INT, CSig.T_CSTRING], CSig.T_INT64))
    }

    // FFmpeg build version string.
    public version(): string {
        return this._readAndFreeStr(this._version.call([]))
    }

    // Decode a file's best audio stream to 16 kHz MONO PCM. `fmt` is FFMPEG_F32
    // (default, whisper's format) or FFMPEG_F64. Throws on error.
    public decodeAudio(path: string, fmt: int = 0): AudioBuffer {
        const raw: any = this._audio_decode.call([path, fmt])
        const p: CPtr = new CPtr(raw, false, -1)
        if (p.isNull()) {
            throw new Error("ffmpeg.decodeAudio: " + this.lastError())
        }
        return new AudioBuffer(this, p)
    }

    // Open a media file for frame-by-frame RGB24 video decode. `filter` is an
    // optional FFmpeg video filtergraph applied to every frame before it is
    // handed back as RGB24, for example:
    //   "scale=1280:720"                 resize
    //   "crop=in_w/2:in_h:0:0"           crop the left half
    //   "hflip"                          mirror
    //   "fps=15"                         resample to 15 fps
    //   "drawtext=text='hi':x=10:y=10"   burn-in text (watermark)
    //   "scale=640:-1,hflip"             chain with commas
    // Empty (default) = no filter. Throws on error.
    public openVideo(path: string, filter: string = ""): VideoReader {
        const raw: any = this._video_open.call([path, filter])
        const p: CPtr = new CPtr(raw, false, -1)
        if (p.isNull()) {
            throw new Error("ffmpeg.openVideo: " + this.lastError())
        }
        return new VideoReader(this, p)
    }

    // Transcode a file, re-encoding video with `encoder` (default the macOS
    // hardware H.264 encoder). `filter` is an optional video filtergraph applied
    // before re-encoding (empty = none), e.g. "scale=1280:720" to downscale or
    // "crop=in_w:in_h-100:0:50,scale=640:-2" to crop-then-resize. `audio` selects
    // how the audio track is handled: AudioEncoder.COPY (default) keeps it as-is,
    // AudioEncoder.AAC re-encodes it to AAC. Returns the number of video frames
    // written. Throws on error.
    public transcode(inPath: string, outPath: string, encoder: VideoEncoder = VideoEncoder.H264, filter: string = "", audio: AudioEncoder = AudioEncoder.COPY, opts: EncodeOptions? = null): int {
        // Pass the codec FAMILY; the shim resolves the best encoder built for
        // this platform (hardware first, software fallback).
        var name: string = "mpeg4"
        if (encoder == VideoEncoder.H264) { name = "h264" }
        else if (encoder == VideoEncoder.HEVC) { name = "hevc" }
        else if (encoder == VideoEncoder.MJPEG) { name = "mjpeg" }
        var aud: string = "copy"
        if (audio == AudioEncoder.AAC) { aud = "aac" }
        const spec: string = opts != null ? opts.spec() : ""
        const n: int = this._transcode.call([inPath, outPath, name, filter, aud, spec])
        if (n < 0) { throw new Error("ffmpeg.transcode: " + this.lastError()) }
        return n
    }

    // The actual video encoder the last transcode() resolved to (e.g.
    // "h264_videotoolbox" on macOS, "h264_vaapi" on a Linux HW build, "mpeg4").
    // Empty before the first transcode. Lets callers tell hardware from software.
    public lastVideoEncoder(): string {
        return this._readAndFreeStr(this._last_video_encoder.call([]))
    }

    // True if `name` is an encoder compiled into this build (e.g. "h264_vaapi",
    // "h264_videotoolbox"). Probe hardware support without attempting an encode.
    public hasEncoder(name: string): bool {
        return this._has_encoder.call([name]) == 1
    }

    // Open a frame encoder writing to `outPath`. Frames are `width`x`height`
    // RGB24, pushed via VideoWriter.writeFrame(); `fps` sets the timebase (num/
    // den defaults to fps/1). `encoder` is the codec family (default hardware
    // H.264), resolved to the best encoder for this platform. The container is
    // chosen from the output extension (.mp4/.mov/.mkv...). Throws on error.
    public createVideo(outPath: string, width: int, height: int, fps: int = 30, encoder: VideoEncoder = VideoEncoder.H264, opts: EncodeOptions? = null): VideoWriter {
        var name: string = "mpeg4"
        if (encoder == VideoEncoder.H264) { name = "h264" }
        else if (encoder == VideoEncoder.HEVC) { name = "hevc" }
        else if (encoder == VideoEncoder.MJPEG) { name = "mjpeg" }
        const spec: string = opts != null ? opts.spec() : ""
        const raw: any = this._venc_open.call([outPath, width, height, fps, 1, name, spec])
        const p: CPtr = new CPtr(raw, false, -1)
        if (p.isNull()) {
            throw new Error("ffmpeg.createVideo: " + this.lastError())
        }
        return new VideoWriter(this, p, width, height)
    }

    // Mux a video file and an audio file into `outPath` by stream copy (no
    // re-encode). Pairs with createVideo(): render frames to a silent video,
    // then add the timeline's audio track. Returns the number of video packets
    // written. Throws on error.
    public mux(videoPath: string, audioPath: string, outPath: string): int {
        const n: int = this._mux.call([videoPath, audioPath, outPath])
        if (n < 0) { throw new Error("ffmpeg.mux: " + this.lastError()) }
        return n
    }

    // Read a file's metadata (size, duration, fps, codecs, audio layout) WITHOUT
    // decoding any frames: opens the container, inspects the best video/audio
    // streams, and returns a MediaInfo. Cheap enough to call on every import.
    // close() the result (or bind with `using const`). Throws on error.
    public probe(path: string): MediaInfo {
        const raw: any = this._probe.call([path])
        const p: CPtr = new CPtr(raw, false, -1)
        if (p.isNull()) {
            throw new Error("ffmpeg.probe: " + this.lastError())
        }
        return new MediaInfo(this, p)
    }

    // Join media files end to end into `outPath` by stream copy (no re-encode),
    // the in-process equivalent of the ffmpeg concat demuxer. Inputs must share
    // a stream layout (same codecs/params) — e.g. an editor's export chunks;
    // each file's timestamps are shifted so playback stays continuous. Returns
    // the number of packets written. Throws on error.
    public concat(paths: []string, outPath: string): int {
        const raw: any = this._concat_new.call([])
        const b: CPtr = new CPtr(raw, false, -1)
        if (b.isNull()) { throw new Error("ffmpeg.concat: " + this.lastError()) }
        for (var i: int = 0; i < paths.length; i = i + 1) {
            const rc: int = this._concat_add.call([b, paths[i]])
            if (rc < 0) {
                this._concat_free.call([b])
                throw new Error("ffmpeg.concat: " + this.lastError())
            }
        }
        const n: int = this._concat_run.call([b, outPath])
        if (n < 0) { throw new Error("ffmpeg.concat: " + this.lastError()) }
        return n
    }

    // Save one RGB24 frame to an image file: PNG when `path` ends in ".png",
    // otherwise JPEG. `rgb` points at width*height*3 bytes (or padded rows);
    // `stride` is its bytes-per-row (0 = packed width*3), so a VideoReader's
    // frame() + stride() pass straight through. Throws on error.
    public saveImage(rgb: CPtr, width: int, height: int, path: string, stride: int = 0): void {
        const rc: int = this._save_image.call([rgb, width, height, stride, path])
        if (rc < 0) { throw new Error("ffmpeg.saveImage: " + this.lastError()) }
    }

    // Encode a numbered image sequence (image2 pattern, e.g. "frames/%06d.jpg")
    // to a video at `fps`. `filter` and `opts` apply exactly as in transcode
    // (e.g. a scale/pad filtergraph, or EncodeOptions().faststart()). Image
    // sequences carry no audio; add a soundtrack afterwards with mux(). Returns
    // the number of frames written. Throws on error.
    public encodeImages(pattern: string, outPath: string, fps: int = 30, encoder: VideoEncoder = VideoEncoder.H264, filter: string = "", opts: EncodeOptions? = null): int {
        var name: string = "mpeg4"
        if (encoder == VideoEncoder.H264) { name = "h264" }
        else if (encoder == VideoEncoder.HEVC) { name = "hevc" }
        else if (encoder == VideoEncoder.MJPEG) { name = "mjpeg" }
        const spec: string = opts != null ? opts.spec() : ""
        const n: int = this._encode_images.call([pattern, outPath, name, filter, spec, fps])
        if (n < 0) { throw new Error("ffmpeg.encodeImages: " + this.lastError()) }
        return n
    }

    // Encode a video (or image sequence) to an animated GIF using the standard
    // palette pipeline (palettegen + paletteuse) for good colour, in a single
    // pass (no intermediate palette file). `fps` caps the rate (0 => 15); `scale`
    // is an optional scale filter, e.g. "scale=480:-1:flags=lanczos" ("" = keep
    // size). Returns the number of frames written. Throws on error.
    public toGif(input: string, outPath: string, fps: int = 15, scale: string = ""): int {
        const n: int = this._to_gif.call([input, outPath, fps, scale])
        if (n < 0) { throw new Error("ffmpeg.toGif: " + this.lastError()) }
        return n
    }

    // Last error message from the shim.
    public lastError(): string {
        return this._readAndFreeStr(this._last_error.call([]))
    }

    // Read a *mut c_char the shim returned, then free it via chuks_ffmpeg_free_string.
    public _readAndFreeStr(raw: any): string {
        const p: CPtr = new CPtr(raw, false, -1)
        if (p.isNull()) { return "" }
        const s: string = c.string(p)
        this._free_string.call([p])
        return s
    }
}
