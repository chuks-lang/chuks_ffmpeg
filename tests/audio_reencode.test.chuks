// Audio RE-ENCODE: transcode an MP3-audio source to AAC. Because the source is
// mp3 and we pass AudioEncoder.AAC, the output audio must be genuinely decoded
// -> resampled (aformat filtergraph) -> AAC-encoded (not stream-copied). We
// assert, purely in Chuks, that the output still has the video frames and a
// recoverable ~1s audio track. (Codec == aac is checked by ffprobe in the suite.)
import { Ffmpeg, VideoEncoder, VideoReader, AudioBuffer, AudioEncoder } from "../src/index.chuks"

const DIR: string = "/Users/chukwuemekaigbokwe/Box/Code/ChuksPackages/chuks_ffmpeg"
const ff: Ffmpeg = new Ffmpeg(DIR + "/shim")

const n: int = ff.transcode("/tmp/ff_mp3.mp4", "/tmp/ff_reenc.mp4", VideoEncoder.H264, "", AudioEncoder.AAC)

const v: VideoReader = ff.openVideo("/tmp/ff_reenc.mp4")
var vf: int = 0
while (v.next()) { vf = vf + 1 }
v.close()

const a: AudioBuffer = ff.decodeAudio("/tmp/ff_reenc.mp4")
const samples: int = a.samples()
a.close()

println("reencode -> frames: " + string(n) + "  video: " + string(vf) + "  audio: " + string(samples) + " samples")
const ok: bool = n == 10 && vf == 10 && samples >= 15000 && samples <= 17000
println("AUDIO REENCODE OK: " + string(ok))
