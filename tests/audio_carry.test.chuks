// Transcode carries the audio track (video re-encoded, audio stream-copied).
// Input /tmp/ff_av.mp4 = 320x240 / 10fps / 1s video + 1s AAC tone. We assert,
// purely in Chuks, that the output still has BOTH tracks: openVideo() sees the
// video frames, and decodeAudio() on the same output recovers ~1s of 16 kHz
// mono PCM (~16000 samples). Also checks a filtered transcode keeps its audio.
import { Ffmpeg, VideoEncoder, VideoReader, AudioBuffer } from "../src/index.chuks"

const DIR: string = "/Users/chukwuemekaigbokwe/Box/Code/ChuksPackages/chuks_ffmpeg"
const IN: string = "/tmp/ff_av.mp4"
const ff: Ffmpeg = new Ffmpeg(DIR + "/shim")

// Count video frames and recovered audio samples of a transcoded file.
function check(out: string): []int {
    const v: VideoReader = ff.openVideo(out)
    var vf: int = 0
    var w: int = 0
    while (v.next()) {
        vf = vf + 1
        if (vf == 1) { w = v.width() }
    }
    v.close()
    const a: AudioBuffer = ff.decodeAudio(out)
    const samples: int = a.samples()
    a.close()
    return [vf, samples, w]
}

// Plain transcode: audio carried through, geometry unchanged.
const n: int = ff.transcode(IN, "/tmp/ff_av_out.mp4", VideoEncoder.H264)
const r: []int = check("/tmp/ff_av_out.mp4")
println("plain    -> frames: " + string(n) + "  video: " + string(r[0]) + "  audio: " + string(r[1]) + " samples  w: " + string(r[2]))
const okPlain: bool = n == 10 && r[0] == 10 && r[1] >= 15000 && r[1] <= 17000 && r[2] == 320

// Filtered transcode: downscale video, audio still carried.
const m: int = ff.transcode(IN, "/tmp/ff_av_scaled.mp4", VideoEncoder.H264, "scale=160:120")
const r2: []int = check("/tmp/ff_av_scaled.mp4")
println("filtered -> frames: " + string(m) + "  video: " + string(r2[0]) + "  audio: " + string(r2[1]) + " samples  w: " + string(r2[2]))
const okFiltered: bool = m == 10 && r2[0] == 10 && r2[1] >= 15000 && r2[1] <= 17000 && r2[2] == 160

println("AUDIO CARRY OK: " + string(okPlain && okFiltered))
