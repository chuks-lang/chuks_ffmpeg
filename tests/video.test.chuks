// Video decode: 320x240 / 10fps / 1s clip → ~10 RGB24 frames.
import { Ffmpeg, VideoReader } from "../src/index.chuks"
import { CPtr } from "std/chuksToC"

const DIR: string = "/Users/chukwuemekaigbokwe/Box/Code/ChuksPackages/chuks_ffmpeg"
const ff: Ffmpeg = new Ffmpeg(DIR + "/shim")

const vid: VideoReader = ff.openVideo("/tmp/ff_test.mp4")
var count: int = 0
var w: int = 0
var h: int = 0
var stride: int = 0
var ptrOk: bool = true
while (vid.next()) {
    count = count + 1
    if (count == 1) {
        w = vid.width()
        h = vid.height()
        stride = vid.stride()
        const fp: CPtr = vid.frame()          // borrowed RGB24 buffer
        if (fp.isNull()) { ptrOk = false }
    }
}
vid.close()
println("frames: " + string(count) + "  size: " + string(w) + "x" + string(h) + "  stride: " + string(stride) + "  ptrOk: " + string(ptrOk))
const okV: bool = count >= 9 && count <= 11 && w == 320 && h == 240 && stride >= 960 && ptrOk
println("VIDEO DECODE OK: " + string(okV))
