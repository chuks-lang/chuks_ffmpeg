// Video filtergraph: the same 320x240 / 10fps / 1s clip run through filters.
//   scale=160:120  -> output frames are 160x120 (size-changing)
//   hflip          -> unchanged geometry, still 320x240 (1:1 filter)
//   fps=5          -> ~5 frames out of ~10 in (frame-count-changing, exercises
//                     the pull-driven drain path)
import { Ffmpeg, VideoReader } from "../src/index.chuks"
import { CPtr } from "std/chuksToC"

const DIR: string = "/Users/chukwuemekaigbokwe/Box/Code/ChuksPackages/chuks_ffmpeg"
const CLIP: string = "/tmp/ff_test.mp4"
const ff: Ffmpeg = new Ffmpeg(DIR + "/shim")

// Run a filter and report (frames, width, height, first-frame-ptr-ok).
function run(spec: string): []int {
    const vid: VideoReader = ff.openVideo(CLIP, spec)
    var count: int = 0
    var w: int = 0
    var h: int = 0
    var ptrOk: int = 1
    while (vid.next()) {
        count = count + 1
        if (count == 1) {
            w = vid.width()
            h = vid.height()
            const fp: CPtr = vid.frame()
            if (fp.isNull()) { ptrOk = 0 }
        }
    }
    vid.close()
    return [count, w, h, ptrOk]
}

const sc: []int = run("scale=160:120")
println("scale=160:120  -> frames: " + string(sc[0]) + "  size: " + string(sc[1]) + "x" + string(sc[2]))
const okScale: bool = sc[1] == 160 && sc[2] == 120 && sc[0] >= 9 && sc[0] <= 11 && sc[3] == 1

const fl: []int = run("hflip")
println("hflip          -> frames: " + string(fl[0]) + "  size: " + string(fl[1]) + "x" + string(fl[2]))
const okFlip: bool = fl[1] == 320 && fl[2] == 240 && fl[0] >= 9 && fl[0] <= 11 && fl[3] == 1

const fp5: []int = run("fps=5")
println("fps=5          -> frames: " + string(fp5[0]) + "  size: " + string(fp5[1]) + "x" + string(fp5[2]))
const okFps: bool = fp5[0] >= 4 && fp5[0] <= 6 && fp5[1] == 320 && fp5[2] == 240

println("FILTER OK: " + string(okScale && okFlip && okFps))
