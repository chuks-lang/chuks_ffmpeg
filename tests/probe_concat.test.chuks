// Probe (metadata without decoding) + concat (join clips by stream copy).
// Also exercises `using const`: the MediaInfo and VideoReader handles are bound
// with `using const` inside bare blocks, so the compiler closes each at block end.
import { Ffmpeg, MediaInfo, VideoReader } from "../src/index.chuks"

const DIR: string = "/Users/chukwuemekaigbokwe/Box/Code/ChuksPackages/chuks_ffmpeg"
const ff: Ffmpeg = new Ffmpeg(DIR + "/shim")

// ---- probe: /tmp/ff_av.mp4 is 320x240 / 10fps / ~1s video + ~1s AAC ----
var okProbe: bool = false
{
    using const info = ff.probe("/tmp/ff_av.mp4")   // auto-closed at block end
    const w: int = info.width()
    const h: int = info.height()
    const dur: float = info.duration()
    const fps: float = info.fps()
    const vc: string = info.videoCodec()
    const ac: string = info.audioCodec()
    println("probe: " + string(w) + "x" + string(h)
        + "  dur " + string(dur) + "s  fps " + string(fps)
        + "  v=" + vc + "  a=" + ac
        + "  " + string(info.sampleRate()) + "Hz/" + string(info.channels()) + "ch")
    okProbe = (info.hasVideo() && info.hasAudio()
        && w == 320 && h == 240
        && vc == "h264" && ac == "aac"
        && dur > 0.8 && dur < 1.6
        && fps > 9.0 && fps < 11.0
        && info.sampleRate() > 0 && info.channels() > 0)
}

// ---- concat: join the 10-frame clip with itself -> 20 frames ----
const pkts: int = ff.concat(["/tmp/ff_test.mp4", "/tmp/ff_test.mp4"], "/tmp/ff_concat.mp4")
var frames: int = 0
var cw: int = 0
{
    using const v = ff.openVideo("/tmp/ff_concat.mp4")   // auto-closed at block end
    while (v.next()) {
        frames = frames + 1
        if (frames == 1) { cw = v.width() }
    }
}
println("concat: packets " + string(pkts) + "  frames " + string(frames) + "  width " + string(cw))
const okConcat: bool = frames == 20 && cw == 320

println("PROBE + CONCAT OK: " + string(okProbe && okConcat))
