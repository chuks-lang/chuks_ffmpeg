// GIF: single-pass palette encode of a video clip (+ scale), read back.
import { Ffmpeg, VideoReader } from "../src/index.chuks"
import { fs } from "std/fs"
const DIR: string = "/Users/chukwuemekaigbokwe/Box/Code/ChuksPackages/chuks_ffmpeg"
const ff: Ffmpeg = new Ffmpeg(DIR + "/shim")

// /tmp/ff_test.mp4 = 320x240, 10 frames @ 10fps -> gif at 10fps, width 160.
const n: int = ff.toGif("/tmp/ff_test.mp4", "/tmp/ff_out.gif", 10, "scale=160:-1:flags=lanczos")
const exists: bool = fs.exists("/tmp/ff_out.gif")
var sz: int = 0
if (exists) { const st: any = fs.stat("/tmp/ff_out.gif"); sz = int(st["size"]) }

using const chk = ff.openVideo("/tmp/ff_out.gif")
var frames: int = 0
var w: int = 0
while (chk.next()) { frames = frames + 1; if (frames == 1) { w = chk.width() } }
println("gif: n=" + string(n) + " frames=" + string(frames) + " w=" + string(w) + " bytes=" + string(sz))
const ok: bool = n == 10 && frames >= 1 && exists && sz > 0 && w == 160
println("GIF OK: " + string(ok))
